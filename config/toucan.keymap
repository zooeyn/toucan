#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <175>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
    hold-trigger-on-release;
};

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        mac: mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "MAC";
        };

        win: win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "WIN";
        };
    };

    combos {
        compatible = "zmk,combos";

        mac {
            bindings = <&mac>;
            key-positions = <36 37 38>;
        };

        win {
            bindings = <&win>;
            key-positions = <39 40 41>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <24 35>;
        };

        layer {
            bindings = <&tog 2>;
            key-positions = <36 41>;
        };

        lbrc {
            bindings = <&kp LBRC>;
            key-positions = <4 5>;
        };

        rbrc {
            bindings = <&kp RBRC>;
            key-positions = <6 7>;
        };

        lpar {
            bindings = <&kp LPAR>;
            key-positions = <16 17>;
        };

        rpar {
            bindings = <&kp RPAR>;
            key-positions = <18 19>;
        };

        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <28 29>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <30 31>;
        };

        excl {
            bindings = <&kp EXCL>;
            key-positions = <2 3>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <3 4>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <14 15>;
        };

        dllr {
            bindings = <&kp DLLR>;
            key-positions = <15 16>;
        };

        amps {
            bindings = <&kp AMPS>;
            key-positions = <26 27>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <28 27>;
        };

        times {
            bindings = <&kp STAR>;
            key-positions = <8 7>;
        };

        mod {
            bindings = <&kp PRCNT>;
            key-positions = <9 8>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <19 20>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <20 21>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <31 32>;
        };

        under {
            bindings = <&kp UNDER>;
            key-positions = <32 33>;
        };

        clear {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <36 37 38 39 40 41>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp F  &kp P  &kp B  &kp J  &kp L  &kp U  &kp Y  &kp SQT  &kp BSLH  &kp ESC  &mt LSHFT A  &mt LCTRL R  &mt LALT S  &mt LCMD T  &kp G  &kp M  &mt RCMD N  &mt RALT E  &mt RCTRL I  &mt RSHFT O  &kp SEMI  &kp LSHFT  &kp Z  &kp X  &kp C  &kp D  &kp V  &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT  &mo 2  &kp SPACE  &kp TAB  &kp ENTER  &kp BSPC  &mo 2
            >;
        };

        win {
            bindings = <
&kp GRAVE  &kp Q  &kp W  &kp F  &kp P  &kp B  &kp J  &kp L  &kp U  &kp Y  &kp SQT  &kp BSLH  &kp ESC  &mt LSHFT A  &mt LWIN R  &mt LALT S  &mt LCTRL T  &kp G  &kp M  &mt RCTRL N  &mt RALT E  &mt RWIN I  &mt RSHFT O  &kp SEMI  &kp LSHFT  &kp Z  &kp X  &kp C  &kp D  &kp V  &kp K  &kp H  &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT  &mo 2  &kp SPACE  &kp TAB  &kp ENTER  &kp BSPC  &mo 2
            >;
        };

        sym {
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5  &kp N6  &kp N7  &kp N8  &kp N9  &kp N0  &trans  &trans  &kp C_VOL_DN  &mkp MB4  &kp PG_UP  &kp PG_DN  &mkp MB5  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp C_VOL_UP  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
