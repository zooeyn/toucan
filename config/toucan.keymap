#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    quick-tap-ms = <175>;
    tapping-term-ms = <280>;
    require-prior-idle-ms = <150>;
    flavor = "balanced";
    hold-trigger-on-release;
};

&lt {
    quick-tap-ms = <175>;
    require-prior-idle-ms = <150>;
    tapping-term-ms = <200>;
    flavor = "balanced";
};

/ {
    conditional_layers { compatible = "zmk,conditional-layers"; };

    macros {
        mac: mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0 &to 0>;
            label = "MAC";
        };

        win: win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 1 &to 1>;
            label = "WIN";
        };
    };

    combos {
        compatible = "zmk,combos";

        mac {
            bindings = <&mac>;
            key-positions = <36 37 38>;
            timeout-ms = <100>;
            require-prior-idle-ms = <150>;
        };

        win {
            bindings = <&win>;
            key-positions = <39 40 41>;
            timeout-ms = <100>;
            require-prior-idle-ms = <150>;
        };

        caps {
            bindings = <&kp CAPS>;
            key-positions = <13 22>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        layer {
            bindings = <&tog 2>;
            key-positions = <36 41>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        lbrc {
            bindings = <&kp LBRC>;
            key-positions = <4 5>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        rbrc {
            bindings = <&kp RBRC>;
            key-positions = <6 7>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        lpar {
            bindings = <&kp LPAR>;
            key-positions = <16 17>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        rpar {
            bindings = <&kp RPAR>;
            key-positions = <18 19>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        lbkt {
            bindings = <&kp LBKT>;
            key-positions = <28 29>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        rbkt {
            bindings = <&kp RBKT>;
            key-positions = <30 31>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        excl {
            bindings = <&kp EXCL>;
            key-positions = <2 3>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        at {
            bindings = <&kp AT>;
            key-positions = <26 27>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        caret {
            bindings = <&kp CARET>;
            key-positions = <14 15>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        dllr {
            bindings = <&kp DLLR>;
            key-positions = <15 16>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        amps {
            bindings = <&kp AMPS>;
            key-positions = <3 4>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        hash {
            bindings = <&kp HASH>;
            key-positions = <27 28>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        times {
            bindings = <&kp STAR>;
            key-positions = <8 7>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        mod {
            bindings = <&kp PRCNT>;
            key-positions = <9 8>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        plus {
            bindings = <&kp PLUS>;
            key-positions = <31 32>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <32 33>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        under {
            bindings = <&kp UNDER>;
            key-positions = <20 21>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        clear {
            bindings = <&bt BT_CLR>;
            key-positions = <36 37 38 39 40 41>;
            timeout-ms = <100>;
            require-prior-idle-ms = <150>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <21 22>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        semi {
            bindings = <&kp SEMI>;
            key-positions = <9 10>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        bslh {
            bindings = <&kp BSLH>;
            key-positions = <34 33>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        esc {
            bindings = <&kp ESC>;
            key-positions = <13 14>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <1 2>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };

        pipe {
            key-positions = <25 26>;
            timeout-ms = <50>;
            require-prior-idle-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        mac {
            bindings = <
&kp GRAVE  &kp Q        &kp W        &kp F            &kp P       &kp B    &kp J      &kp L       &kp U            &kp Y        &kp SQT      &kp BSLH
&kp ESC    &mt LSHFT A  &mt LCTRL R  &mt LALT S       &mt LCMD T  &kp G    &kp M      &mt RCMD N  &mt RALT E       &mt RCTRL I  &mt RSHFT O  &kp SEMI
&kp LSHFT  &kp Z        &kp X        &kp C            &kp D       &kp V    &kp K      &kp H       &kp COMMA        &kp DOT      &kp FSLH     &kp RSHFT
                                     &lt 2 LA(SPACE)  &kp SPACE   &kp TAB  &kp ENTER  &kp BSPC    &lt 2 RA(SPACE)
            >;
        };

        win {
            bindings = <
&kp GRAVE  &kp Q        &kp W       &kp F            &kp P        &kp B    &kp J      &kp L        &kp U            &kp Y       &kp SQT      &kp BSLH
&kp ESC    &mt LSHFT A  &mt LWIN R  &mt LALT S       &mt LCTRL T  &kp G    &kp M      &mt RCTRL N  &mt RALT E       &mt RWIN I  &mt RSHFT O  &kp SEMI
&kp LSHFT  &kp Z        &kp X       &kp C            &kp D        &kp V    &kp K      &kp H        &kp COMMA        &kp DOT     &kp FSLH     &kp RSHFT
                                    &lt 2 LA(SPACE)  &kp SPACE    &kp TAB  &kp ENTER  &kp BSPC     &lt 2 RA(SPACE)
            >;
        };

        sym {
            bindings = <
&trans  &kp N1    &kp N2    &kp N3     &kp N4     &kp N5     &kp N6    &kp N7     &kp N8     &kp N9     &kp N0    &trans
&trans  &mkp MB4  &kp LEFT  &kp UP     &kp DOWN   &kp RIGHT  &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &mkp MB5  &trans
&trans  &trans    &trans    &kp PG_UP  &kp PG_DN  &trans     &trans    &kp PG_DN  &kp PG_UP  &trans     &trans    &trans
                            &trans     &trans     &trans     &trans    &trans     &trans
            >;
        };
    };
};
